# Local user data: NEVER commit to git (the DB contains collected history,
# settings.json contains the Telegram bot token in plaintext)
backend/case.db
# WAL sidecars (database.py sets journal_mode=WAL): SQLite keeps recent
# transactions here until a checkpoint folds them back into case.db, so they
# are user data exactly like it is.
backend/case.db-wal
backend/case.db-shm
backend/settings.json
backend/app.log*
backend/service.log*
nssm.exe

# Private working notes kept beside the checkout, never published. Anchored with
# a leading slash on purpose: unanchored, these names match at ANY depth, and on
# a case-insensitive filesystem `AUDIT.md` silently swallowed `docs/audit.md`.
/CLAUDE.md
/AUDIT.md
/IMPROVEMENTS.md
/PIANO_LANCIO_PRIVATE.md
/.agents/
/.gemini/
/.phasekit/

# The OMI supply from the Agenzia delle Entrate: free to obtain, not open data,
# and the extracted folder names carry the requester's codice fiscale. It stays
# beside the checkout so the app can be pointed at it, and never inside it.
/omi-input/


# Environments and dependencies
backend/.venv/
frontend/node_modules/
__pycache__/
.pytest_cache/

# Dev-tooling caches and reports (ruff / hypothesis / coverage / vitest):
# local only, regenerated on demand, never part of the source
backend/.ruff_cache/
backend/.hypothesis/
backend/.coverage
backend/htmlcov/
frontend/coverage/

# Build and temporary files
frontend/dist/
frontend/*.tsbuildinfo
frontend/vite.config.ts.timestamp-*.mjs

# PyInstaller output and work directory (scripts/build_release.py --package).
# Anchored with a leading slash so this never swallows frontend/dist's sibling
# names further down the tree.
/dist/
/build/
# Generated from frontend/public/icon-512.png at build time, so the tray icon
# and the PWA icon cannot drift into being two different logos.
packaging/app.ico
# Bind mount for packaging/docker-compose.yml: holds case.db and settings.json,
# so it follows the same never-commit rule as the database itself.
packaging/data/

# Automatic DB backups (see backend/app/services/backup.py): local copies of
# case.db, same never-commit rule as the DB itself
backend/backups/

# Playwright's persistent browser profile for automatic DataDome cookie
# harvesting (services/cookie_harvester.py): local browser state, same
# never-commit rule as case.db and settings.json.
backend/browser_profile/
